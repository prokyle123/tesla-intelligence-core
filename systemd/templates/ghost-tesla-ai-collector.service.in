[Unit]
Description=GHOST Tesla Learning Engine Telemetry Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__GHOST_USER__
Group=__GHOST_USER__
WorkingDirectory=/opt/ghost-tesla-ai
Environment=PYTHONPATH=/opt/ghost-tesla-ai
ExecStart=/opt/ghost-tesla-ai/venv/bin/python -m ghost_tesla_ai.collector
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
