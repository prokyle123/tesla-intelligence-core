[Unit]
Description=Tesla Intelligence Core Shadow Forecast Quality v2
After=ghost-tesla-ai-collector.service
Wants=ghost-tesla-ai-collector.service

[Service]
Type=oneshot
User=__GHOST_USER__
Group=__GHOST_USER__
WorkingDirectory=/opt/ghost-tesla-ai
Environment=PYTHONPATH=/opt/ghost-tesla-ai
ExecStart=/opt/ghost-tesla-ai/venv/bin/python -m ghost_tesla_ai.quality_runner forecast
NoNewPrivileges=true
PrivateTmp=true
Nice=10
TimeoutStartSec=10min
UMask=0077
